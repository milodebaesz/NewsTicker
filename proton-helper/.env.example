# Kopieer dit bestand naar .env en vul je eigen gegevens in.
# Deze waarden komen uit de Proton Bridge-app (tabblad IMAP/SMTP-instellingen).

# IMAP-adres van Proton Bridge (standaard onderstaande waarden)
PROTON_IMAP_HOST=127.0.0.1
PROTON_IMAP_PORT=1143

# Je Proton-e-mailadres
PROTON_EMAIL=jij@proton.me

# LET OP: het door Bridge gegenereerde wachtwoord (NIET je Proton-accountwachtwoord).
# Te vinden in Bridge → je account → "Mailbox details / IMAP password".
PROTON_BRIDGE_PASSWORD=

# Poort waarop dit helper-servertje draait (vrij te kiezen)
HELPER_PORT=8910

# Zelfverzonnen geheime sleutel; dezelfde waarde vul je in de extensie-instellingen in.
# Genereer bv. met: openssl rand -hex 16
HELPER_TOKEN=
