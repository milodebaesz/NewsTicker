{
  "manifest_version": 3,
  "name": "Newsticker — jouw relevante nieuws",
  "version": "0.1.0",
  "description": "Verzamelt nieuws (RSS), Gmail en Google Agenda en filtert met AI op wat voor jou relevant is.",
  "permissions": ["storage", "alarms", "identity"],
  "host_permissions": ["<all_urls>"],
  "key": "",
  "oauth2": {
    "client_id": "242379989630-5ertsvim4qfkqnbevde88307vdbdcqgd.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.modify",
      "https://www.googleapis.com/auth/calendar.readonly"
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
